{
	"manifest_version": 3,
	"name": "Agent Multi Tab Use",
	"version": "1.5.0",
	"minimum_chrome_version": "118",
	"description": "Let many AI agents drive your Chrome at once: one port per agent, named tab groups, no tab fights.",
	"permissions": ["debugger", "tabs", "tabGroups", "storage", "alarms"],
	"background": {
		"service_worker": "background.js"
	},
	"icons": {
		"16": "icons/icon16.png",
		"32": "icons/icon32.png",
		"48": "icons/icon48.png",
		"128": "icons/icon128.png"
	},
	"options_page": "options.html",
	"action": {
		"default_title": "Agent Multi Tab Use",
		"default_icon": {
			"16": "icons/icon16.png",
			"32": "icons/icon32.png"
		}
	}
}
